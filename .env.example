# Postgres. Preset `quick` : URL Neon/Supabase. Preset `durable` : le service
# postgres de docker-compose ou celui provisionné dans Coolify.
# Chaque projet a son propre port Postgres, posé au scaffold dans un fichier
# `.env` (lu par docker compose, pas `.env.local`) — pas seulement quand 5432
# est déjà pris. L'URL ci-dessous porte le même port.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# Better Auth. Générer le secret avec : openssl rand -base64 32
# BETTER_AUTH_URL doit porter le port de dev du projet — celui du script `dev`
# dans package.json et de `.claude/launch.json`. Sur un autre port, les cookies
# et les redirections partent au mauvais endroit.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Anthropic (si l'outil appelle un LLM)
ANTHROPIC_API_KEY=""
